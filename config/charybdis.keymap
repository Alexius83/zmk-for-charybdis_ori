#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC                  &kp N1  &kp N2  &kp N3        &kp N4     &kp N5      &kp N6          &kp N7     &kp N8     &kp N9            &kp N0    &kp BACKSPACE
&kp TAB                  &kp Q   &kp W   &kp E         &kp R      &kp T       &kp Y           &kp U      &kp I      &kp O             &kp P     &kp BSLH
&mt LEFT_SHIFT CAPSLOCK  &kp A   &kp S   &kp D         &kp F      &kp G       &kp H           &kp J      &kp K      &kp L             &kp SEMI  &kp SQT
&kp LCTRL                &kp Z   &kp X   &kp C         &kp V      &kp B       &kp N           &kp M      &kp COMMA  &kp LEFT_BRACKET  &kp FSLH  &kp MINUS
                                         &kp LEFT_ALT  &kp SPACE  &to 1       &msc SCRL_UP    &kp ENTER
                                                       &mkp MB1   &mkp MB2    &msc SCRL_DOWN
            >;

            trackball-bindings = <&tmv_coarse>;
        };

        layer_1 {
            bindings = <
&kp F1          &kp F2      &kp F3    &kp F4        &kp F5     &kp F6      &kp F7     &kp F8      &kp F9      &kp F10            &kp F11  &kp F12
&kp CAPS        &kp INS     &kp HOME  &kp PG_UP     &none      &none       &none      &none       &kp UP      &none              &none    &none
&kp LEFT_SHIFT  &kp DELETE  &kp END   &kp PG_DN     &none      &none       &none      &kp LEFT    &kp DOWN    &kp RIGHT          &none    &none
&kp LCTRL       &none       &none     &none         &none      &none       &none      &none       &kp PERIOD  &kp RIGHT_BRACKET  &none    &kp EQUAL
                                      &kp LEFT_WIN  &kp SPACE  &to 2       &kp LALT   &kp DELETE
                                                    &mkp MB1   &mkp MB2    &kp ENTER
            >;

            trackball-bindings = <&tsl>;
        };

        layer_2 {
            bindings = <
&kp LS(TILDE)   &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)
&kp TAB         &kp LBKT      &kp RBKT       &kp LS(LBRC)   &kp LS(RBRC)  &kp SEMI         &kp LS(COLON)  &kp SQT        &kp LS(DQT)   &kp RET       &kp LS(PIPE)  &kp EQUAL
&kp LEFT_SHIFT  &kp FSLH      &kp LS(QMARK)  &kp UP         &kp COMMA     &kp DOT          &kp LS(LT)     &kp LS(GT)     &kp FSLH      &kp STAR      &kp MINUS     &kp PLUS
&kp LCTRL       &trans        &kp LEFT       &kp DOWN       &kp RIGHT     &trans           &trans         &trans         &trans        &trans        &trans        &trans
                                             &trans         &kp SPACE     &to 0            &kp LEFT_ALT   &kp BACKSPACE
                                                            &mkp MB1      &mkp MB2         &kp RET
            >;
        };
    };
};
